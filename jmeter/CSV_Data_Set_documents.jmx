            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters">C:\dev\app-web-notebook-lm\jmeter\</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">import java.io.FileWriter;
import java.io.File;
import java.text.SimpleDateFormat;
import java.util.Date;

synchronized(this) {
    try {
        // Get the base username from the thread
        String nombre_usuario = vars.get(&quot;nombre_usuario&quot;);
        String directoryPath = Parameters;
        String csv_filename = &quot;csv_jwt_id.csv&quot;;
        // Get the dynamic variables
        String chat_id = vars.get(nombre_usuario + &quot;_chat_id&quot;);
        String jwtoken = vars.get(nombre_usuario + &quot;_token&quot;);
        String question = &quot;¿Qué dice el texto?&quot;;
        
        // Define CSV file path - now in D:/documents
        String csvFile = directoryPath + csv_filename;
        
        // Ensure directory exists
        new File(directoryPath).mkdirs();
        
        FileWriter writer = new FileWriter(csvFile, true); // true for append mode
        
        // Write header if file is empty
        if (new File(csvFile).length() == 0) {
            writer.append(&quot;chat_id,jwtoken,question\n&quot;);
        }
        
        // Write data row
        writer.append(chat_id != null ? chat_id : &quot;&quot;).append(&quot;,&quot;);
        writer.append(jwtoken != null ? jwtoken : &quot;&quot;).append(&quot;,&quot;);
        writer.append(question).append(&quot;\n&quot;);
        
        writer.flush();
        writer.close();
        
        log.info(&quot;Saved data for user: &quot; + nombre_usuario + &quot; to &quot; + directoryPath);
    } catch (Exception e) {
        log.error(&quot;Error writing to CSV: &quot; + e.getMessage());
    }
}
</stringProp>
            </BeanShellPostProcessor>
